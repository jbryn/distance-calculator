{
    "name": "jbryn/distance-calculator",
    "description": "This is a recruitment task project. It's goal is to enable user with ability to calculate distances between geographical coordinates.",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Jbryn\\DistanceCalculator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jbryn\\DistanceCalculator\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "jbryn",
            "email": "brynski.jan@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "ext-mbstring": "*",
        "slim/slim": "^4.11",
        "slim/psr7": "^1.6",
        "php-di/slim-bridge": "^3.4",
        "vlucas/phpdotenv": "^5.5",
        "guzzlehttp/guzzle": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "symfony/var-dumper": "^6.0",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff",
        "lint": [
            "@analyse",
            "@format:check"
        ],
        "start": "php -S localhost:8080 -t public"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    }
}
