APP_DEBUG=true

# Origin of the frontend that is allowed to call the API
CORS_ORIGIN=http://localhost:5173

# --- River data (OpenStreetMap, through the Overpass API). All optional; the defaults work. ---

# true (the default) = answer only from the saved river data in api/data, never from the network.
# Set to false only to fetch or refresh that data: see api/data/README.md
# OVERPASS_OFFLINE=true

# Where the river data is saved
# OVERPASS_CACHE_DIR=/absolute/path/to/folder

# The rest only matters when OVERPASS_OFFLINE=false

# Servers to query, comma-separated, tried in order
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter

# How this application identifies itself to those servers
# OVERPASS_USER_AGENT=distance-calculator (+https://github.com/jbryn/distance-calculator)

# For how many seconds saved data counts as fresh before it is fetched again (default 30 days)
# OVERPASS_CACHE_TTL=2592000
